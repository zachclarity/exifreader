    )

settings = Settings()

RUNNING = True

def handle_shutdown(signum: int, frame: Any) -> None:
    global RUNNING
    logger.info("Shutdown signal received: %s", signum)
    RUNNING = False


signal.signal(signal.SIGINT, handle_shutdown)
signal.signal(signal.SIGTERM, handle_shutdown)

def create_boto3_client(service_name: str):
    return boto3.client(
        service_name,
        region_name=settings.aws_region,
        aws_access_key_id=settings.aws_access_key_id,
        aws_secret_access_key=settings.aws_secret_access_key,
        endpoint_url=settings.endpoint_url,
    )


sqs_client = create_boto3_client("sqs")
s3_client = create_boto3_client("s3")

def parse_message_body(body: str) -> Dict[str, Any]:
    try:
        payload = json.loads(body)
        logger.debug("Parsed message payload: %s", payload)
        return payload
    except json.JSONDecodeError as exc:
        raise ValueError(f"Invalid JSON message body: {exc}") from exc


def validate_payload(payload: Dict[str, Any]) -> Dict[str, Any]:
    document_id = payload["documentId"]
    bucket = settings.s3_upload_bucket
    document_type = payload.get("documentType", "unknown")

    if not document_id:
        raise ValueError("Missing required field: documentId")
  
    key = f"{document_id}"

    return {
        "documentId": document_id,
        "Bucket": bucket,
        "Key": key,
        "documentType": document_type,
    }

def phase_receive_message() -> Optional[Dict[str, Any]]:
    logger.info("Polling SQS queue: %s", settings.sqs_file_queue_url)

    response = sqs_client.receive_message(
        QueueUrl=settings.sqs_file_queue_url,
        MaxNumberOfMessages=settings.max_messages,
        WaitTimeSeconds=settings.poll_wait_seconds,
        VisibilityTimeout=settings.visibility_timeout,
    )

    messages = response.get("Messages", [])
    if not messages:
        logger.debug("No messages received")
        return None

    return messages[0]


def phase_parse_message(message: Dict[str, Any]) -> Dict[str, Any]:
    logger.info("Phase: parse_message")
    body = message.get("Body", "")
    payload = parse_message_body(body)
    validated = validate_payload(payload)
    logger.info(
        "Message validated | documentId=%s Bucket=%s Key=%s Type=%s",
        validated["documentId"],
        validated["Bucket"],
        validated["Key"],
        validated["documentType"],
    )
    return validated


def phase_download_document(payload: Dict[str, Any]) -> str:
    logger.info("Phase: download_document | documentId=%s", payload["documentId"])
    local_path = download_s3_file(
        s3_client=s3_client,
        bucket_name=payload["Bucket"],
        object_key=payload["Key"],
        document_id=payload["documentId"],
    )
    logger.info("Downloaded file to: %s", local_path)
    return local_path

def extract_pdf_images(local_path: str, payload: Dict[str, Any]) -> str:
   
    logger.info("PDF Images extraction phase started for: %s", local_path)
  
    try:
        doc = fitz.open(local_path)
        text = ""
        img_count = 1
        img_task_arr = []
        with tempfile.TemporaryDirectory(prefix="img-extract-") as tmp_dir:

            for page_num in range(len(doc)):
                page = doc.load_page(page_num)
                image_list = page.get_images(full=True)
                
                for img_index, img in enumerate(image_list):
                    xref = img[0]
                    base_image = doc.extract_image(xref)
                    image_bytes = base_image["image"]
                    ext = base_image["ext"]
                    
                    img_filename = f"img_{page_num}_{img_index}.{ext}"
                    local_img_path = os.path.join(tmp_dir, img_filename)
                    
                    with open(local_img_path, "wb") as f:
                        f.write(image_bytes)
                    
                    img_s3_key = f"{payload['documentId']}_ext_{img_filename}"
                    s3_client.upload_file(local_img_path, settings.s3_tmp_bucket, img_s3_key)
                    
                    img_task = payload.copy()
                    img_task['originalDocumentId'] = payload["documentId"]
                    img_task['documentId'] = img_s3_key
                    img_task['imageIndex'] = img_index
                    img_task['media_type'] = "IMAGE"

                    img_task_arr.append(img_task)
                    img_count += 1
                              
        logger.info(f"Extracted {img_count} images from PDF.")
        return img_count
    except UnicodeDecodeError as exc:
        raise RuntimeError(f"Unable to decode text file: {local_path}") from exc
    except OSError as exc:
        raise RuntimeError(f"Unable to read file: {local_path}") from exc
    finally:
        if doc:
            doc.close()
            logger.debug("Closed PDF document handle.")

def phase_extract_content(local_path: str, payload: Dict[str, Any]) -> Dict[str, Any]:
    logger.info("Phase: extract_content type=%s | file=%s", payload["documentType"], local_path)
    try:
        result = process_document_pipeline(
            file_path=local_path,
            document_type=payload["documentType"]
        )
        logger.info("Processing")
        logger.info(payload["documentId"])
        if (payload["documentType"] == "PDF" ):
            save_to_db(payload["documentId"], result)
            num_imgs = extract_pdf_images(local_path, payload)
            send_ocr_message(settings.sqs_ocr_queue_url, payload, num_imgs)
        else: 
            send_ocr_message(settings.sqs_ocr_queue_url, payload, 1)
            
        logger.info(
            "Extraction complete | method=%s chars=%s",
            result.get("method"),
            len(result.get("text", "")),
        )
    except Exception as e:
        print(f"An error occurred: {e}")
    return result


def save_to_db(document_id, file_path):
    
    db_config = {
        "dbname": settings.coral_db_name,
        "user": settings.coral_db_user,
        "password": settings.coral_db_password,
        "host": settings.coral_db_host,
        "port": settings.coral_db_port
    }

    try:
        with psycopg.connect(**db_config) as conn:
            with open(file_path, "rb") as f:
                conn.execute(
                    "UPDATE coral_documents SET doc_read = %s WHERE document_id = %s",
                    (f, doc_id) # Psycopg 3 detects the file-like object and streams it
                 )
        
            print(f"Successfully saved data for Document ID: {document_id}")
            conn.close();  
    except Exception as e:
        print(f"An error occurred: {e}")

def phase_delete_message(receipt_handle: str) -> None:
    logger.info("Phase: delete_message")
    sqs_client.delete_message(
        QueueUrl=settings.sqs_file_queue_url,
        ReceiptHandle=receipt_handle,
    )
    logger.info("Message deleted from queue")

def get_safe_dedup_id(original_filename):
    unix_timestamp = int(time.time())
    timestamped_filename = f"{unix_timestamp}_{original_filename}"
    filename_bytes = timestamped_filename.encode('utf-8')
    return hashlib.sha256(filename_bytes).hexdigest()

def send_ocr_message(queueUrl, payload, num_imgs=1):
    document_id = payload["documentId"]
    logger.info(queueUrl)
    payload['NumImages'] = num_imgs
    deduplication_id = get_safe_dedup_id(document_id)
    clean_group_id = "ocr-processing-group"
    
    try:
        sqs_client.send_message(
            QueueUrl=queueUrl,
            MessageBody=json.dumps(payload),
            MessageGroupId=clean_group_id,
            MessageDeduplicationId=deduplication_id
        )
        logger.info("OCR Message Sent")
        return True
    except Exception as e:
        logger.error(f"Error sending OCR message: {e}")
        return False
        
def phase_handle_success(payload: Dict[str, Any], result: Dict[str, Any]) -> None:
    logger.info(
        "SUCCESS | documentId=%s | Method=%s | Preview=%s",
        payload["documentId"],
        result.get("method"),
        result.get("text", "")[:120].replace("\n", " "),
    )


def phase_handle_failure(message: Optional[Dict[str, Any]], exc: Exception) -> None:
    logger.exception("FAILED processing message: %s", exc)

def handle_message(message: Dict[str, Any]) -> None:
    local_path: Optional[str] = None
    receipt_handle = message.get("ReceiptHandle")

    try:
        payload = phase_parse_message(message)
        local_path = phase_download_document(payload)
        doc_type = payload.get('documentType', '').upper()

        if doc_type == "PDF":
            result = phase_extract_content(local_path, payload)
            phase_handle_success(payload, result)
            
        elif doc_type == "TXT":
            save_to_db(payload["documentId"], local_path)
            logger.info("TXT processed and saved to DB.")
            
        else:
            logger.info("Routing to OCR pipeline...")
            send_ocr_message(settings.sqs_ocr_queue_url, payload, 1)

        phase_delete_message(receipt_handle)

    except Exception as exc:
        phase_handle_failure(message, exc)
    finally:
        if local_path:
            cleanup_temp_file(local_path)

def run() -> None:
    logger.info("Starting SQS document worker...")
    logger.info("AWS endpoint: %s", settings.endpoint_url)
    logger.info("Queue URL: %s", settings.sqs_file_queue_url)
    logger.info("Bucket: %s", settings.s3_upload_bucket)

    while RUNNING:
        try:
            message = phase_receive_message()
            if not message:
                time.sleep(settings.sleep_on_empty)
                continue

            handle_message(message)

        except (ClientError, BotoCoreError) as exc:
            logger.exception("AWS communication error: %s", exc)
            time.sleep(5)

        except Exception as exc:
            logger.exception("Unexpected top-level error: %s", exc)
            time.sleep(5)

    logger.info("Worker stopped cleanly")


if __name__ == "__main__":
    run()

